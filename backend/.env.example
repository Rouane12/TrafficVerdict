APP_NAME=TrafficVerdict API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://trafficverdict:trafficverdict_dev@localhost:55432/trafficverdict
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-this-with-a-long-random-secret
SESSION_COOKIE_NAME=trafficverdict_session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

# Google OAuth shared by Analytics + Search Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_ANALYTICS_SCOPE=https://www.googleapis.com/auth/analytics.readonly
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:8000/api/integrations/search-console/callback
GOOGLE_SEARCH_CONSOLE_SCOPE=https://www.googleapis.com/auth/webmasters.readonly
CREDENTIAL_ENCRYPTION_SECRET=replace-this-with-a-different-long-random-secret
